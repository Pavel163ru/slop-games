# FTP / FTPS deploy settings (copy to .env and fill in)
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=username
FTP_PASSWORD=password

# Remote directory where dist/ contents are uploaded (absolute path on server)
FTP_REMOTE_DIR=/public_html

# Use FTPS (explicit TLS)? true or false
FTP_SECURE=false

# Reject invalid TLS certificates? Set to true for strict checks.
FTP_REJECT_UNAUTHORIZED=false
